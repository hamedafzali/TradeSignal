# Copy this file to .env and fill in your values

# Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Your personal Telegram chat ID (for admin alerts & /train command)
# Send any message to @userinfobot to find it
ADMIN_CHAT_ID=your_chat_id_here

# Your Telegram channel ID where signals are broadcast
# Create a channel, add your bot as admin, then use @channelname or the numeric ID
CHANNEL_ID=@your_channel_name

# Comma-separated stock tickers to watch
SYMBOLS=AAPL,TSLA,NVDA,MSFT

# How often to scan (minutes)
SCAN_INTERVAL_MINUTES=5

# How many hours after a signal to check its outcome
OUTCOME_CHECK_HOURS=24

# Dashboard settings
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
